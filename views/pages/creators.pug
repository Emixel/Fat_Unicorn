extends ../../masterframe/layout.pug

block content
  section.content-page creators-page(aria-labelledby="page-title")
    header.page-heading
      p.eyebrow Creators
      h1#page-title.page-title Our streamers
      p.page-lede Catch the herd live. Drop a follow and say hi in chat!

    .creator-grid
      article.creator-card
        span.platform-tag Twitch
        h2 Uniqueen
        p Mostly plays Valorant
      article.creator-card
        span.platform-tag YouTube
        h2 Chubbyhoof
        p Mostly plays Minecraft
      article.creator-card
        span.platform-tag Twitch
        h2 Magicmuncher
        p Mostly plays Apex Legends
      article.creator-card
        span.platform-tag TikTok
        h2 Sparklz
        p Mostly plays Fortnite
      article.creator-card
        span.platform-tag Kick
        h2 Hornybot
        p Mostly plays CS2
      article.creator-card
        span.platform-tag YouTube
        h2 Ponypixel
        p Mostly plays indie games
